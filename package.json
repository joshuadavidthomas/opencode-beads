    "@types/node": "^22.0.0",
    "eslint": "^9.x",
    "eslint-config-prettier": "^10.x",
    "prettier": "^3.x",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.x"
  },
  "engines": {
    "bun": ">=1.0.0"
  }
}
